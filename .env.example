# All values are optional — MoneyPilot runs fully offline without any of them.

# --- AI advisor (only used when you host server.ts) ------------------------
# Without a key the app falls back to its built-in offline rule engine.
GEMINI_API_KEY=""

# The previous build hard-coded "gemini-3.6-flash". If that id is not enabled
# on your key the endpoint 500s and it looks like the AI is broken.
GEMINI_MODEL="gemini-2.5-flash"

# --- Server-side backup email (optional) -----------------------------------
# Leave blank to use the device's own mail app instead, which is the default
# and the only option inside the APK.
# Requires: npm install nodemailer
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- Hosting ---------------------------------------------------------------
PORT="3000"
APP_URL=""

# --- Google Drive sync (optional) ------------------------------------------
# Create at console.cloud.google.com -> Credentials -> OAuth client ID (Web).
# See GOOGLE_SYNC.md. Never commit a real value.
VITE_GOOGLE_CLIENT_ID=""
