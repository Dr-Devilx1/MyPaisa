# Capacitor generates this; recreate with `npm run android:add`
android/
ios/

# Signing keys — never commit these
*.jks
*.keystore
*.jks.b64

# ...except the shared debug key. It is deliberately public (password
# "android", same as the AOSP debug key) so every CI build signs identically
# and installs as an update instead of wiping the user's data.
!android-signing/mypaisa-debug.keystore
